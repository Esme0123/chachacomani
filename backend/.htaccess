# Evita listar carpetas si no hay un index
Options -Indexes

# ---------------------------------------------------------------------------
# Enrutamiento (API + React Frontend)
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Rutas del API PHP (/api/...)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api/index.php?ruta=$1 [QSA,L]

    # 2. Rutas del Frontend React (Evita Error 404 al recargar /perfil, /caja-chica, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# MIME de respuestas JSON
AddType application/json .json

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/json "access plus 1 minute"
</IfModule>

# Denegación de acceso directo a archivos sensibles de configuración/librerías
<FilesMatch "^(db\.php|helpers\.php|roles\.php|auth_lib\.php|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# Ocultar errores en pantalla en producción
<IfModule mod_php8.c>
    php_flag display_errors Off
</IfModule>

# Bloquear descargas de archivos SQL, logs o respaldos en cualquier carpeta
RedirectMatch 404 ^/.*\.(sql|log|bak|old|sh)$